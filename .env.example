# S3 Configuration
# For testing, you can use:
# 1. Real AWS S3 (requires AWS account)
# 2. LocalStack (local S3 emulator)
# 3. MinIO (local S3-compatible storage)

S3_ACCESS_KEY_ID=your_access_key_here
S3_SECRET_ACCESS_KEY=your_secret_key_here
S3_REGION=us-east-1
S3_BUCKET_NAME=test-migration-bucket
# Optional: For LocalStack or MinIO
# S3_ENDPOINT_URL=http://localhost:4566

# Storacha Configuration
# You'll need to sign up at https://storacha.network to get these credentials
STORACHA_API_KEY=your_storacha_api_key_here
STORACHA_ENDPOINT_URL=https://api.storacha.network
STORACHA_SPACE_NAME=your-space-name

# Migration Configuration (optional)
MIGRATION_BATCH_SIZE=100
MIGRATION_TIMEOUT_SECONDS=300
MIGRATION_RETRY_ATTEMPTS=3
MIGRATION_VERBOSE=true
MIGRATION_DRY_RUN=false

